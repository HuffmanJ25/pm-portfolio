---
import { LINKS, PERSON } from '../consts';
import { url } from '../lib/url';
import Icon from './Icon.astro';
---

<footer class="site-footer">
	<div class="container inner">
		<div>
			<p class="sign">Let's build something useful.</p>
			<p class="small">{PERSON.name} · {PERSON.role} · {PERSON.location}</p>
		</div>
		<ul class="links">
			<li>
				<a href={`mailto:${LINKS.email}`}><Icon name="mail" /> Email</a>
			</li>
			<li>
				<a href={LINKS.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" /> LinkedIn</a>
			</li>
			<li>
				<a href={LINKS.github} target="_blank" rel="noopener"><Icon name="github" /> GitHub</a>
			</li>
			<li>
				<a href={url('/rss.xml')}><Icon name="rss" /> RSS</a>
			</li>
		</ul>
	</div>
	<div class="container copy"><p class="small">© {new Date().getFullYear()} {PERSON.name}</p></div>
</footer>

<style>
	.site-footer {
		padding-block: 3rem 2rem;
		background: var(--surface-2);
		border-top: 1px solid var(--line);
	}
	.inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
		flex-wrap: wrap;
	}
	.sign {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-style: italic;
		margin: 0 0 0.25rem;
	}
	.small {
		font-size: 0.9rem;
		color: var(--ink-soft);
		margin: 0;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.links a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--ink);
		text-decoration: none;
		font-weight: 700;
	}
	.links a:hover {
		color: var(--accent-ink);
	}
	.copy {
		margin-top: 2rem;
	}
</style>
