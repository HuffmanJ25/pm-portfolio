---
// Small inline icon set (stroke icons), so no icon library is needed.
interface Props {
	name: 'download' | 'mail' | 'linkedin' | 'github' | 'arrow-right' | 'arrow-left' | 'rss';
	label?: string;
}
const { name, label } = Astro.props;
---

<svg
	viewBox="0 0 24 24"
	width="20"
	height="20"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden={label ? undefined : 'true'}
	aria-label={label}
	role={label ? 'img' : undefined}
>
	{name === 'download' && <path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />}
	{name === 'mail' && (
		<>
			<rect x="3" y="5" width="18" height="14" rx="2" />
			<path d="m3 7 9 6 9-6" />
		</>
	)}
	{name === 'linkedin' && (
		<>
			<rect x="3" y="3" width="18" height="18" rx="3" />
			<path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" />
		</>
	)}
	{name === 'github' && (
		<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
	)}
	{name === 'arrow-right' && <path d="M5 12h14m-6-6 6 6-6 6" />}
	{name === 'arrow-left' && <path d="M19 12H5m6-6-6 6 6 6" />}
	{name === 'rss' && <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16M5 19h.01" />}
</svg>
