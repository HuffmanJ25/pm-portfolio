---
// Imported here so the theme is on every page.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import Headshot from '../assets/headshot.jpg';
import { SITE_TITLE } from '../consts';
import { url } from '../lib/url';

interface Props {
	title?: string;
	description: string;
	image?: ImageMetadata;
}

const { title, description, image = Headshot } = Astro.props;
const fullTitle = title ? `${title} · Joel Huffman` : SITE_TITLE;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: image, width: 1200, format: 'jpg' });
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
<link rel="sitemap" href={url('/sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title="Writing by Joel Huffman" href={url('/rss.xml')} />
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-body" preload />
<Font cssVariable="--font-display" preload />

<link rel="canonical" href={canonicalURL} />

<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
<meta name="twitter:card" content="summary_large_image" />
