---
import { getCollection } from 'astro:content';
import WorkCard from '../../components/WorkCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Work" description="Case studies from Joel Huffman: the problem, the decisions and tradeoffs, and the results.">
	<section class="section">
		<div class="container">
			<span class="eyebrow">Case studies</span>
			<h1>Work</h1>
			<p class="lede">
				Each case study covers the problem, my role, the decisions and tradeoffs, and what happened. Results first.
			</p>
			<div class="grid">{work.map((entry) => <WorkCard entry={entry} />)}</div>
		</div>
	</section>
</BaseLayout>

<style>
	.lede {
		margin-bottom: 2.5rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
		gap: 1.25rem;
	}
</style>
