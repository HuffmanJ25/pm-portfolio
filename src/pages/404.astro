---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
	<section class="section">
		<div class="container center">
			<span class="eyebrow">404</span>
			<h1>This page took a different flight.</h1>
			<p class="lede">The link may be old, or the page moved.</p>
			<a class="btn btn-primary" href={url('/')}>Back home</a>
		</div>
	</section>
</BaseLayout>

<style>
	.center {
		text-align: center;
	}
	.lede {
		margin-inline: auto;
		margin-bottom: 2rem;
	}
</style>
