---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import headshot from '../assets/headshot.jpg';
import Icon from '../components/Icon.astro';
import Timeline from '../components/Timeline.astro';
import WorkCard from '../components/WorkCard.astro';
import { LINKS, PERSON, RESUME_PDF_URL, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);

const stats = [
	{ value: '6+ yrs', label: 'in travel & hospitality tech' },
	{ value: 'Millions', label: 'of travelers on a platform I owned' },
	{ value: 'Weeks → hours', label: 'to resolve stuck reservations' },
];
---

<BaseLayout description={SITE_DESCRIPTION}>
	<section class="hero">
		<div class="container hero-grid">
			<div class="intro">
				<span class="eyebrow">{PERSON.role} · {PERSON.focus}</span>
				<h1>Hi, I’m Joel. I turn messy systems into products <em>people trust.</em></h1>
				<p class="lede">
					I’ve spent 6+ years in travel and hospitality technology, most recently owning a global traveler-profile
					platform used by thousands of companies. I use AI every day for discovery, diagnosis and prototyping.
				</p>
				<p class="currently"><span class="pulse" aria-hidden="true"></span><strong>Currently:</strong> {PERSON.currently}</p>
				<div class="actions">
					<a class="btn btn-primary" href={RESUME_PDF_URL} target="_blank" rel="noopener">
						<Icon name="download" /> Download resume
					</a>
					<a class="btn btn-ghost" href={`mailto:${LINKS.email}`}><Icon name="mail" /> Get in touch</a>
					<a class="btn btn-ghost" href={LINKS.linkedin} target="_blank" rel="noopener">
						<Icon name="linkedin" /> LinkedIn
					</a>
				</div>
			</div>
			<div class="photo">
				<Picture
					src={headshot}
					alt="Joel Huffman, smiling, in a dark blazer and clear glasses"
					widths={[320, 480, 720]}
					sizes="(max-width: 860px) 280px, 400px"
					formats={['avif', 'webp']}
					loading="eager"
					fetchpriority="high"
				/>
				<span class="blob" aria-hidden="true"></span>
			</div>
		</div>
		<ul class="container stats">
			{
				stats.map((s) => (
					<li>
						<strong>{s.value}</strong>
						<span>{s.label}</span>
					</li>
				))
			}
		</ul>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-head">
				<div>
					<span class="eyebrow">Selected work</span>
					<h2>Problems I’ve solved</h2>
				</div>
				<a href={url('/work/')}>All case studies →</a>
			</div>
			<div class="grid">{work.map((entry) => <WorkCard entry={entry} />)}</div>
		</div>
	</section>

	<section class="section band">
		<div class="container">
			<div class="section-head">
				<div>
					<span class="eyebrow">Career at a glance</span>
					<h2>How I got here</h2>
				</div>
				<a href={url('/experience/')}>Full experience →</a>
			</div>
			<Timeline idPrefix="home" />
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		padding-block: clamp(2.5rem, 6vw, 5rem) 2rem;
		overflow-x: clip;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	h1 em {
		font-style: italic;
		color: var(--accent-ink);
	}
	.currently {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		flex-wrap: wrap;
		padding: 0.75rem 1rem;
		border-radius: var(--radius-sm);
		background: var(--sage-soft);
		font-size: 0.97rem;
		max-width: 60ch;
	}
	.pulse {
		align-self: center;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--sage);
		flex: none;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	.photo {
		position: relative;
		justify-self: center;
		width: min(400px, 100%);
	}
	.photo :global(img) {
		position: relative;
		z-index: 1;
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: 50% 25%;
		border-radius: 46% 54% 42% 58% / 38% 40% 60% 62%;
		box-shadow: var(--shadow-lift);
	}
	.blob {
		position: absolute;
		inset: 8% -6% -5% 8%;
		border-radius: 58% 42% 55% 45% / 45% 55% 45% 55%;
		background: var(--accent-soft);
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		list-style: none;
		padding: 0;
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}
	.stats li {
		padding: 1.1rem 1.25rem;
		border-radius: var(--radius);
		background: var(--surface);
		border: 1px solid var(--line);
	}
	.stats strong {
		display: block;
		font-family: var(--font-display);
		font-size: 1.8rem;
		color: var(--accent-ink);
		line-height: 1.1;
	}
	.stats span {
		font-size: 0.93rem;
		color: var(--ink-soft);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
		gap: 1.25rem;
	}
	.band {
		background: var(--surface-2);
	}
	.band :global(.tl-viewport::before) {
		background: linear-gradient(to right, var(--surface-2), transparent);
	}
	.band :global(.tl-viewport::after) {
		background: linear-gradient(to left, var(--surface-2), transparent);
	}
	.band :global(.tl-dot) {
		box-shadow: 0 0 0 5px var(--surface-2);
	}

	@media (max-width: 860px) {
		.hero-grid {
			grid-template-columns: 1fr;
		}
		.photo {
			order: -1;
			width: min(280px, 75%);
		}
		.stats {
			grid-template-columns: 1fr;
		}
	}
</style>
