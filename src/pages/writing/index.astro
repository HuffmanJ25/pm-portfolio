---
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Writing" description="Notes on product management, platforms and building with AI, by Joel Huffman.">
	<section class="section">
		<div class="container narrow">
			<span class="eyebrow">Writing</span>
			<h1>Notes on building products</h1>
			<p class="lede">Short pieces on product decisions, platforms and working with AI.</p>

			{
				posts.length === 0 ? (
					<p class="empty">First posts are on the way.</p>
				) : (
					<ul class="posts">
						{posts.map((post) => (
							<li>
								<a href={url(`/writing/${post.id}/`)}>
									<FormattedDate date={post.data.pubDate} />
									<h2>{post.data.title}</h2>
									<p>{post.data.description}</p>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</section>
</BaseLayout>

<style>
	.narrow {
		max-width: 780px;
	}
	.lede {
		margin-bottom: 2.5rem;
	}
	.posts {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.posts a {
		display: block;
		padding: 1.5rem;
		margin-inline: -1.5rem;
		border-radius: var(--radius);
		color: var(--ink);
		text-decoration: none;
		transition: background 0.2s ease;
	}
	.posts a:hover {
		background: var(--surface);
	}
	.posts time {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--sage);
	}
	.posts h2 {
		font-size: 1.5rem;
		margin: 0.25rem 0 0.4rem;
	}
	.posts a:hover h2 {
		color: var(--accent-ink);
	}
	.posts p {
		margin: 0;
		color: var(--ink-soft);
	}
	.empty {
		padding: 2rem;
		border-radius: var(--radius);
		background: var(--surface);
		border: 1px dashed var(--line);
		text-align: center;
		color: var(--ink-soft);
	}
</style>
